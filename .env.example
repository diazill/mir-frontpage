# Laravel API URL, including the version prefix (server only). Next.js fetches
# it in Server Components and route handlers, so the browser never calls it
# directly and it needs no NEXT_PUBLIC_ prefix.
# Local Laravel: http://127.0.0.1:8000/api/v1
LARAVEL_API_URL=https://<domain-api>/api/v1

# Public storefront origin for canonical URLs, sitemap, and structured data.
SITE_URL=http://localhost:3000

# Store WhatsApp number: digits only, with country code (e.g. 62812xxxxxxx).
# It is shown on the site, so it may be exposed to the browser.
NEXT_PUBLIC_STORE_WHATSAPP=<nomor-whatsapp>
